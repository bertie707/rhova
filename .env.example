# Postgres connection string (e.g. from Neon or Supabase)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Anthropic API key — used to extract structured club data from pasted notes
# in the admin panel (see src/app/api/admin/extract/route.ts)
ANTHROPIC_API_KEY="sk-ant-..."

# Bcrypt hash of the shared /admin password — never the plain password.
# Generate with: npm run hash-password -- "your password"
ADMIN_PASSWORD_HASH="$2b$12$..."

# Random secret used to sign the admin session cookie — generate with e.g.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="changeme-too"

# Club photo storage — create a Blob store in the Vercel dashboard's Storage
# tab and copy its token here (also auto-injected if you connect the store
# to your Vercel project's env vars directly).
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Shown as a "Feedback" contact link on the public map — set to your own address
NEXT_PUBLIC_CONTACT_EMAIL="you@example.com"
